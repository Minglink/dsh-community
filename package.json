{
  "name": "dsh-community",
  "version": "0.2.1-alpha.1",
  "description": "DeepSeek Harness (DSH) 官方与开源生态「插件与 Skill 市场」（Plugins & Skills Market）",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh-plugin",
    "dsh-extension",
    "cordis",
    "cordis-plugin",
    "plugin",
    "skill",
    "market",
    "plugin-market",
    "skills-market"
  ],
  "author": "MingLin <minglink@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://deepseek.stream",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minglink/dsh-community.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node build.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.8.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ]
}
